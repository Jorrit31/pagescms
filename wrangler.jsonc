{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beheerscherm",
  // The OpenNext app plus the monthly Cron (cloudflare-worker.ts).
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Keep the variables set in the Cloudflare dashboard on every deploy.
  "keep_vars": true,
  // Webstudio: monthly report mails, 1st of the month 08:00 UTC (09:00 in NL in winter);
  // days 2-5 only retry sites whose mail failed.
  "triggers": { "crons": ["0 8 1-5 * *"] },
  // Store error logs so they can be read under Observability in the dashboard.
  "observability": { "enabled": true },
  // Run the editor close to the database and GitHub instead of close to the
  // visitor: one page needs many small calls to both, so that is much faster.
  "placement": { "mode": "smart" },
  // Keeps database connections open close to the database (Cloudflare
  // Hyperdrive "beheerscherm-db"), so a request no longer has to connect first.
  // db/index.ts uses it when present and falls back to DATABASE_URL otherwise.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dcd432551f814b7d9d8c87f2831ff4e3",
      // Only for local tools (and "opennextjs-cloudflare deploy", which starts a
      // local copy of the bindings first). Without it the deploy stops with "use a
      // local Postgres connection string". Never used online; nothing listens here.
      "localConnectionString": "postgres://lokaal:lokaal@127.0.0.1:5432/lokaal"
    }
  ]
}
